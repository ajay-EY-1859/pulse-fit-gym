# PulseFit Backend Environment Variables
# Copy this file to .env and fill in your values

PORT=5000

# MongoDB connection string
# Local: mongodb://127.0.0.1:27017/pulsefit
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/pulsefit
MONGO_URI=mongodb://127.0.0.1:27017/pulsefit

# JWT secret — use a long random string in production
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# Frontend origin URL (for CORS)
# Local: http://localhost:5173
# Production: https://your-app.vercel.app
CLIENT_ORIGIN=http://localhost:5173
